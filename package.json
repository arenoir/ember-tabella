{
  "name": "ember-tabella",
  "version": "2.0.0-beta.3",
  "description": "Table component utilizing ember-collection.",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "lint": "npm-run-all --aggregate-output --continue-on-error --parallel \"lint:!(fix)\"",
    "lint:fix": "npm-run-all --aggregate-output --continue-on-error --parallel lint:*:fix",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember server",
    "test": "npm-run-all lint test:*",
    "test:ember": "ember test",
    "test:ember-compatibility": "ember try:each"
  },
  "repository": "https://github.com/arenoir/ember-tabella",
  "engines": {
    "node": ">= 18"
  },
  "author": "Aaron Renoir",
  "license": "MIT",
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@ember/optional-features": "^2.0.0",
    "@ember/test-helpers": "^3.3.1",
    "@embroider/test-setup": "^3.0.0",
    "@glimmer/component": "^1.1.2",
    "@glimmer/tracking": "^1.1.2",
    "broccoli-asset-rev": "^3.0.0",
    "ember-auto-import": "^2.2.4",
    "ember-cli": "~4.12.0",
    "ember-cli-app-version": "^5.0.0",
    "ember-cli-dependency-checker": "^3.2.0",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sass": "^10.0.1",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-code-snippet": "^3.0.0",
    "ember-disable-prototype-extensions": "^1.1.3",
    "ember-load-initializers": "^2.1.2",
    "ember-page-title": "^7.0.0",
    "ember-qunit": "^8.0.0",
    "ember-resolver": "^11.0.0",
    "ember-source": "~4.12.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^5.0.0",
    "ember-try": "^3.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-ember": "^11.0.0",
    "eslint-plugin-n": "^16.0.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-qunit": "^7.0.0",
    "loader.js": "^4.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.0",
    "qunit": "^2.19.0",
    "qunit-dom": "^2.0.0",
    "sass": "^1.45.2"
  },
  "keywords": [
    "ember-addon",
    "table"
  ],
  "dependencies": {
    "@ember/render-modifiers": "^2.1.0",
    "@ember/string": "^3.1.1",
    "ember-cli-babel": "^8.2.0",
    "ember-cli-htmlbars": "^6.3.0",
    "ember-collection": "^3.0.0"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config",
    "demoURL": "http://arenoir.github.io/ember-tabella/"
  },
  "volta": {
    "node": "22.22.3",
    "npm": "10.9.8"
  }
}
