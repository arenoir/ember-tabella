<div class="container">
  <h1>Ember Tabella <small>Simple</small></h1>

  <div class="row">
    <div class="col-md-12">
      <div class="example-container">
        <EmberTabella 
          @numFixedColumns={{2}} 
          @width={{500}} 
          @height={{500}} 
          @rowHeight={{50}} 
          @content={{this.tableContent}} 
          @columns={{this.tableColumns}} 
          @hasFooter={{false}} 
          @sortedColumn={{this.sortedColumn}} 
          @isSortReversed={{this._desc}} 
          @onColumnSort={{this.sort}} 
        />
      </div>
    </div>

    <div class="col-md-12 bumper-30">
      <h3>Template</h3>
      {{#let (get-code-snippet "snippets/table-basic.hbs") as |snippet|}}
        <pre class="code-snippet {{snippet.language}}">{{snippet.source}}</pre>
      {{/let}}

    </div>

    <div class="col-md-12 bumper-30">
      <h3>Controller</h3>
      {{#let (get-code-snippet "controllers/application.js") as |snippet|}}
        <pre class="code-snippet {{snippet.language}}">{{snippet.source}}</pre>
      {{/let}}
    </div>
  </div>
</div>
